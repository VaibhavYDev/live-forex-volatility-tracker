# Shared image for all three Python services. One build, three entrypoints —
# they share ~95% of their dependency tree, so three Dockerfiles would mean three
# near-identical layer stacks and three times the build time and pull cost.
#
# Multi-stage: the builder resolves and compiles wheels; the runtime carries only
# the virtualenv. No uv, no compilers, no build headers in the shipped image.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /build

# Manifests first, source second. Dependencies change far less often than code,
# so this ordering means an ordinary code edit reuses the cached dependency layer
# instead of re-resolving the whole tree.
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/
COPY packages/platform/pyproject.toml packages/platform/
COPY apps/api/pyproject.toml apps/api/
COPY apps/ingestor/pyproject.toml apps/ingestor/
COPY apps/worker/pyproject.toml apps/worker/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --no-install-workspace --no-dev --frozen

COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/ingestor/ apps/ingestor/
COPY apps/worker/ apps/worker/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --no-dev --frozen


FROM python:3.12-slim AS runtime

# Non-root. A container that does not need root should not have it, and this is
# the cheapest hardening there is.
RUN useradd --create-home --uid 10001 fx

ENV PATH="/build/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder --chown=fx:fx /build /build

WORKDIR /build
USER fx

# Every service in this image exposes a Prometheus endpoint - the API on 8000,
# the ingestor on 9100, the worker on 9101 - so one probe covers all three if it
# is told which port. Without a HEALTHCHECK the orchestrator cannot tell a wedged
# ingestor from a working one: the process is running either way, and `depends_on`
# will happily start dependents against a container that is up but not doing
# anything.
#
# Compose overrides FX_HEALTH_PORT per service; the API additionally overrides the
# whole check to hit /healthz, which is a real liveness answer rather than "the
# metrics server is listening".
ENV FX_HEALTH_PORT=9100
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c 'import os,urllib.request;urllib.request.urlopen("http://127.0.0.1:"+os.environ["FX_HEALTH_PORT"]+"/metrics",timeout=2)' || exit 1

# Overridden per service in docker-compose.yml.
CMD ["python", "-m", "fx_api.main"]
