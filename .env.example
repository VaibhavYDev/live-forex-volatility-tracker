# ---------------------------------------------------------------------------
# Copy to .env and set FX_PROVIDER_TOKEN. Only real market data is served:
# without a token the ingestor exits (code 78) and the dashboard shows no feed.
# Never commit the filled-in .env. To keep it outside the checkout, put this
# file anywhere and make the checkout's .env the single line
# FX_ENV_FILE=<path to it> (see "Keeping the token outside the checkout").
# ---------------------------------------------------------------------------

# --- data source ------------------------------------------------------------
FX_PROVIDER=tiingo
# Required. Get one at https://www.tiingo.com
FX_PROVIDER_TOKEN=
FX_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCHF

# --- redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Time-based WAL retention. "Keep 15 minutes of replay buffer" is a requirement
# you can state in the README; "keep 1,000,000 entries" is not.
FX_STREAM_RETENTION_S=900

# --- postgres ---------------------------------------------------------------
POSTGRES_USER=fx
POSTGRES_PASSWORD=fx
POSTGRES_DB=fx
DATABASE_URL=postgresql://fx:fx@timescale:5432/fx

# --- worker -----------------------------------------------------------------
# Flush on whichever comes first. Bounded latency AND bounded memory.
FX_FLUSH_MAX_ROWS=500
FX_FLUSH_MAX_SECONDS=2.0
FX_CLAIM_IDLE_MS=60000

# --- ingestor ---------------------------------------------------------------
FX_LEASE_TTL_MS=10000
FX_LEASE_RENEW_MS=3000
FX_STALENESS_TIMEOUT_S=30
FX_BACKOFF_BASE_S=0.5
FX_BACKOFF_CAP_S=60
FX_BREAKER_FAIL_THRESHOLD=5
FX_BREAKER_RESET_S=30

# --- api --------------------------------------------------------------------
FX_WS_TICKET_TTL_S=30
FX_WS_SLOW_CLIENT_DEADLINE_S=10
FX_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- API security -----------------------------------------------------------
# WebSocket ticket auth defaults to ON in code. Local compose sets this to 0
# because the dashboard has no login and therefore cannot redeem a ticket; leave
# it unset (or 1) anywhere the port is reachable by anyone else. See SECURITY.md.
FX_REQUIRE_WS_TICKET=0
FX_RATE_LIMIT_PER_MIN=30
FX_TICKET_LIMIT_PER_MIN=20
FX_COMPARE_CACHE_S=30
