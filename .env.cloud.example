# ---------------------------------------------------------------------------
# Settings for docker-compose.prod.yml (the cloud deployment). On the server:
#
#     cp -n .env.cloud.example .env.cloud && chmod 600 .env.cloud
#
# then fill in every value below. Never commit .env.cloud (it is git-ignored).
# Walkthrough: docs/deploy-cloud.md.
# ---------------------------------------------------------------------------

# Hostname Caddy obtains a certificate for (its A record must point at the server).
FX_DOMAIN=

# Dashboard access. The provider's individual plans license the data for internal
# use only, so the dashboard is password-protected. FX_ACCESS_HASH is a bcrypt hash:
#     docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains '$', which would otherwise be read as
# variable references.
FX_ACCESS_USER=
FX_ACCESS_HASH=''

# Tiingo API token (server side only; the browser never sees it).
FX_PROVIDER_TOKEN=

# Internal datastore passwords. Generate long random values, e.g.
#     openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Image tag; scripts/cloud/deploy.sh sets this per commit.
FX_IMAGE_TAG=local
